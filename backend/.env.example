# Copy this file to `.env` and fill in your values.
# `.env` is gitignored so secrets never leave your machine.

# === Required ===

# Hugging Face token. Needed for pyannote.audio model downloads (Phase 5+).
# Get one at https://huggingface.co/settings/tokens (Read scope is enough).
HF_TOKEN=

# === Optional ===

# Absolute path to ffmpeg.exe.
# Leave blank if ffmpeg is on your system PATH.
# Set this if PATH lookup fails (e.g. ffmpeg installed in a OneDrive-synced
# folder, or PATH was modified after the current shell launched).
#   Windows example: C:\ffmpeg\bin\ffmpeg.exe
#   macOS/Linux example: /usr/local/bin/ffmpeg
FFMPEG_PATH=

# === Tunables (defaults are fine) ===

# Ollama local server
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Per-call LLM timeout (seconds) and max output tokens. Raise the timeout for
# long / Chinese meetings (constrained generation on the 8B model is slow).
OLLAMA_TIMEOUT=1800
OLLAMA_NUM_PREDICT=2048
OLLAMA_REPEAT_PENALTY=1.3

# Whisper model
# 'large-v3' (~3 GB, Int8) is the IR-specified model and the default here.
# Use 'small' (~480 MB) for fast functional iteration.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
# Silero VAD pre-filter threshold inside Faster-Whisper (0-1, higher = stricter).
# 0.5 is the default. Lower it if quiet speech is being dropped.
WHISPER_VAD_THRESHOLD=0.5
# Batched transcription speed-up (parallel VAD windows). ~3-4x faster on long
# audio; set to 1 to disable, or lower (e.g. 4) if you hit VRAM limits.
WHISPER_BATCH_SIZE=8

# Speaker over-detection guard (Phase 9 polish). Any speaker with less than
# this many seconds of TOTAL talk-time is treated as a phantom (a pyannote
# over-segmentation artifact) and merged into its acoustically nearest
# speaker. Applied ONLY when you DON'T enter a speaker count at upload (a
# known count already forces exact clustering). Raise it if genuinely quiet
# speakers get absorbed; lower it to merge less aggressively.
PHANTOM_MAX_SECONDS=3.0

# Maximum upload size in GB (default 4, matching the limit shown in the
# interface). Raise for larger recordings, but mind free disk space (the
# original file is stored) and processing time.
MAX_UPLOAD_GB=4

# Paths (relative to backend/)
DATA_DIR=./data
DB_PATH=./data/app.db
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MODELS_DIR=./data/models
